{
  "description": "Run type-check and lint after file edits",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/verify-edit.sh",
            "timeout": 120,
            "statusMessage": "Running verification..."
          }
        ]
      }
    ]
  }
}
